# Local developer environment — holds absolute paths to plugin sources.
.env
skills/*/infra/*/.env

# PHP engine lives inside the elgg-migrate skill (and is mirrored into
# every sibling skill by bin/gen-elgg-infra.sh). Ignore the transient
# bits that composer/phpunit drop in each copy.
skills/*/vendor/
skills/*/.phpunit.cache/
skills/*/composer.lock

# Beads / Dolt files (local workflow state — not committed)
.beads/
.dolt/
*.db
.beads-credential-key

# OpenWolf context-management tool (local-only)
.wolf/
.claude/rules/openwolf.md
.claude/scheduled_tasks.lock

