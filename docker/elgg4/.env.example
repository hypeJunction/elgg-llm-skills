# Copy to `.env` and edit for your machine. Both values are required.
#
# PLUGINS_DIR  Absolute path to the directory containing plugin sources.
#              Each immediate subdirectory must be a plugin, named with the
#              plugin's lowercase Elgg plugin id.
# PLUGIN_ID    Lowercase plugin id of the plugin under test. The elgg4
#              container mounts only this one plugin — each migration is
#              verified in isolation.

PLUGINS_DIR=/absolute/path/to/your/plugins
PLUGIN_ID=hypeembed
