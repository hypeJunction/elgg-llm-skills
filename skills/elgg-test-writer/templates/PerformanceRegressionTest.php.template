<?php

declare(strict_types=1);

namespace __PLUGIN_NAMESPACE__\Tests;

use Elgg\IntegrationTestCase;

/**
 * Auto-generated performance-regression guard for plugin "__PLUGIN_ID__".
 *
 * Generated by elgg-test-writer. Do not edit by hand — re-run the scaffold.
 *
 * Locks the query cost of this plugin's own entity shapes so a later change (a
 * dropped index, a getter rewrite, a metadata fan-out change) can't silently
 * make them scan an order of magnitude more rows while every functional test
 * stays green. This is the per-plugin companion to the elgg-benchmark skill and
 * the migrate.php --benchmark gate.
 *
 * Metric: Handler_read_next — rows the storage engine walked, read as a DELTA
 * around each getter (SHOW SESSION STATUS before/after, query cache cleared so
 * real SQL runs). Deltas need NO elevated DB privilege (no FLUSH STATUS), so
 * this runs against the plugin's ordinary test DB user.
 *
 * Baseline: tests/.perf-baseline.json maps "shape label" => max Handler_read_next.
 *   - No baseline file yet? The test is skipped and writes the observed numbers
 *     to tests/.perf-baseline.json.observed — review them and commit as
 *     tests/.perf-baseline.json to arm the gate.
 *   - Baseline present? Each shape must stay within TOLERANCE of its recorded
 *     value, or the test fails with the before/after numbers.
 *
 * The shapes are this plugin's (type, subtype) entities, as declared in
 * elgg-plugin.php — the queries other code runs to list this plugin's content.
 */
final class PerformanceRegressionTest extends IntegrationTestCase
{
    /** Allowed growth over the recorded baseline before a shape fails (25%). */
    private const TOLERANCE = 0.25;

    /** @return array<string,array{0:string,1:?string}> label => [type, subtype] */
    private function shapes(): array
    {
        $rows = [
__ENTITY_ROWS__
        ];
        $shapes = [];
        foreach ($rows as $row) {
            [$type, $subtype] = [$row[0], $row[1] ?? null];
            $label = $subtype ? "{$type}:{$subtype}" : $type;
            $shapes[$label] = [$type, $subtype];
        }
        return $shapes;
    }

    private function baselinePath(): string
    {
        return dirname(__DIR__, 2) . '/.perf-baseline.json';
    }

    /** Handler_read_next actually walked by one getter call (query cache cleared). */
    private function measure(string $type, ?string $subtype): int
    {
        $svc  = _elgg_services();
        $conn = $svc->db->getConnection('read');
        $opts = ['type' => $type, 'limit' => 25];
        if ($subtype !== null) {
            $opts['subtype'] = $subtype;
        }

        $read = static function () use ($conn): int {
            $v = $conn->executeQuery(
                "SHOW SESSION STATUS WHERE Variable_name = 'Handler_read_next'"
            )->fetchAssociative();
            return (int) ($v['Value'] ?? 0);
        };

        elgg_get_entities($opts); // warm plan + buffer pool
        $svc->queryCache->clear(); // force real SQL (in-memory reset, no DB I/O)
        $before = $read();
        elgg_get_entities($opts);
        return $read() - $before;
    }

    public function testQueryCostWithinBaseline(): void
    {
        $shapes = $this->shapes();
        if (empty($shapes)) {
            $this->markTestSkipped('Plugin declares no entities — no query shapes to gate.');
        }

        $observed = [];
        foreach ($shapes as $label => [$type, $subtype]) {
            $observed[$label] = $this->measure($type, $subtype);
        }

        $path = $this->baselinePath();
        if (!is_file($path)) {
            file_put_contents(
                $path . '.observed',
                json_encode($observed, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n"
            );
            $this->markTestSkipped(
                'No tests/.perf-baseline.json yet. Observed Handler_read_next written to '
                . '.perf-baseline.json.observed — review and commit it as .perf-baseline.json '
                . 'to arm the gate.'
            );
        }

        $baseline = json_decode((string) file_get_contents($path), true) ?: [];
        $regressions = [];
        foreach ($observed as $label => $now) {
            if (!isset($baseline[$label])) {
                continue; // new shape — not a regression; re-baseline to include it
            }
            $ceiling = (int) ceil($baseline[$label] * (1 + self::TOLERANCE));
            if ($now > $ceiling) {
                $regressions[] = sprintf(
                    '%s: %d rows walked, baseline %d (+%d%% ceiling %d)',
                    $label, $now, $baseline[$label], (int) (self::TOLERANCE * 100), $ceiling
                );
            }
        }

        $this->assertSame(
            [], $regressions,
            "Query-cost regression (Handler_read_next):\n  " . implode("\n  ", $regressions)
            . "\nIf intended (e.g. a schema change proven with elgg-benchmark), re-record "
            . "tests/.perf-baseline.json."
        );
    }
}
