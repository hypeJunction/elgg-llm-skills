<?php

declare(strict_types=1);

namespace __PLUGIN_NAMESPACE__\Tests;

use PHPUnit\Framework\TestCase;

/**
 * Auto-generated regression guard for plugin "__PLUGIN_ID__".
 *
 * Generated by elgg-test-writer. Do not edit by hand — re-run the scaffold.
 *
 * Locks out the recurring runtime-fatal bug classes found during the Elgg
 * 2.x→7.x fleet migration. Each one was a "HTTP 200 / activates fine" plugin
 * that fataled only when a specific page rendered, so a normal smoke test
 * missed it. This is a *static source scan* (no Elgg boot) on purpose: an
 * incompatible method override fatals at class-load, so a booted test could
 * never reach the assertion — the pattern has to be caught in the source.
 *
 * Mirrors elgg-migrate/bin/scan-frontend-residue.sh; keep them in sync.
 *
 * Bug classes covered:
 *   - signature-incompat       (bug-007/013 — override breaks ElggEntity sig)
 *   - viewpage/viewmodule null  (bug — Elgg 7 typed string $title)
 *   - legacy-language-file      (add_translation removed in 5.0)
 *   - removed-instance-method   (ElggPlugin::getManifest/getUserSetting)
 *   - css-view-orphaned         (bug-024 — css/elements/* not loaded on 7.x)
 */
final class RegressionTest extends TestCase
{
    /** Canonical Elgg 7 core signatures (param "type $name" list, defaults stripped). */
    private const CORE_SIG = [
        'canComment'           => 'int $user_guid',
        'canWriteToContainer'  => 'int $user_guid, string $type, string $subtype',
        'canEdit'              => 'int $user_guid',
        'canDelete'            => 'int $user_guid',
        'canAnnotate'          => 'int $user_guid, string $annotation_name',
    ];

    private static function pluginRoot(): string
    {
        $dir = __DIR__;
        for ($i = 0; $i < 6; $i++) {
            if (is_file($dir . '/elgg-plugin.php') || is_file($dir . '/manifest.xml') || is_file($dir . '/composer.json')) {
                return $dir;
            }
            $dir = \dirname($dir);
        }
        return \dirname(__DIR__);
    }

    /** @return list<string> php/css files under $sub (relative dir), vendor dirs skipped */
    private static function files(string $sub, string $ext): array
    {
        $base = self::pluginRoot() . '/' . ltrim($sub, '/');
        if (!is_dir($base)) {
            return [];
        }
        $out = [];
        $it = new \RecursiveIteratorIterator(new \RecursiveDirectoryIterator($base, \FilesystemIterator::SKIP_DOTS));
        foreach ($it as $f) {
            $path = $f->getPathname();
            if (preg_match('#/(vendor|vendors|bower_components|node_modules)/#', $path)) {
                continue;
            }
            if (substr($path, -strlen($ext) - 1) === '.' . $ext) {
                $out[] = $path;
            }
        }
        return $out;
    }

    private static function normParams(string $raw): string
    {
        $tokens = [];
        foreach (explode(',', $raw) as $p) {
            $p = preg_replace('/=.*$/', '', $p);          // drop default value
            $p = trim(preg_replace('/\s+/', ' ', $p));
            if ($p !== '') {
                $tokens[] = $p;
            }
        }
        return implode(', ', $tokens);
    }

    private static function requiresElgg7(): bool
    {
        $composer = self::pluginRoot() . '/composer.json';
        return is_file($composer)
            && (bool) preg_match('/"elgg\/elgg"\s*:\s*"[~^]?7/', (string) file_get_contents($composer));
    }

    public function testNoIncompatibleCoreOverrides(): void
    {
        $violations = [];
        foreach (self::files('classes', 'php') as $file) {
            $src = (string) file_get_contents($file);
            if (!preg_match('/extends\s+\\\\?(ElggEntity|ElggObject|ElggComment|ElggGroup|ElggUser|ElggSite)\b/', $src)) {
                continue;
            }
            foreach (self::CORE_SIG as $method => $want) {
                if (!preg_match('/function\s+' . $method . '\s*\(([^)]*)\)/', $src, $m)) {
                    continue;
                }
                $got = self::normParams($m[1]);
                if ($got !== $want) {
                    $violations[] = sprintf('%s: %s(%s) — core wants %s(%s)', basename($file), $method, $got, $method, $want);
                }
            }
        }
        $this->assertSame([], $violations, "Incompatible core-method override(s) fatal at class load:\n" . implode("\n", $violations));
    }

    public function testNoNullTitleViews(): void
    {
        $violations = [];
        foreach (self::files('views', 'php') as $file) {
            $src = (string) file_get_contents($file);
            if (preg_match('/elgg_view_page\(\s*null\b/', $src)) {
                $violations[] = basename($file) . ': elgg_view_page(null, …)';
            }
            if (preg_match('/elgg_view_module\([^,]+,\s*null\b/', $src)) {
                $violations[] = basename($file) . ': elgg_view_module(…, null, …)';
            }
            if (preg_match('/elgg_view_page\(\s*(\$[a-zA-Z_]\w*)/', $src, $m)) {
                $var = preg_quote($m[1], '/');
                if (!preg_match('/' . $var . '\s*=|as\s+' . $var . '\b|function[^)]*' . $var . '\b/', $src)) {
                    $violations[] = basename($file) . ": elgg_view_page({$m[1]}, …) but {$m[1]} is never assigned → null title";
                }
            }
        }
        $this->assertSame([], $violations, "Null-title view fatals on Elgg 7 (typed string \$title):\n" . implode("\n", $violations));
    }

    public function testNoLegacyLanguageFiles(): void
    {
        $violations = [];
        foreach (self::files('languages', 'php') as $file) {
            if (preg_match('/(^|[^A-Za-z_])add_translation\s*\(/m', (string) file_get_contents($file))) {
                $violations[] = basename($file) . ': uses add_translation() (removed in Elgg 5.0)';
            }
        }
        $this->assertSame([], $violations, "Legacy language files fatal at boot:\n" . implode("\n", $violations));
    }

    public function testNoRemovedInstanceMethods(): void
    {
        $violations = [];
        foreach (self::files('', 'php') as $file) {
            $src = (string) file_get_contents($file);
            if (preg_match('/->getManifest\s*\(|\$plugin->(get|set)UserSetting\s*\(/', $src)) {
                $violations[] = basename($file) . ': removed ElggPlugin method (getManifest/getUserSetting)';
            }
        }
        $this->assertSame([], $violations, "Calls to removed ElggPlugin instance methods:\n" . implode("\n", $violations));
    }

    public function testNoOrphanedCssElementViews(): void
    {
        if (!self::requiresElgg7()) {
            $this->markTestSkipped('css/elements relocation only applies to Elgg 7 targets');
        }
        $root = self::pluginRoot();
        $dir = $root . '/views/default/css/elements';
        if (!is_dir($dir)) {
            $this->assertTrue(true);
            return;
        }
        $allPhp = '';
        foreach (self::files('', 'php') as $f) {
            $allPhp .= file_get_contents($f);
        }
        $violations = [];
        foreach (glob($dir . '/*.css') ?: [] as $css) {
            $base = basename($css);
            $stem = substr($base, 0, -4);
            if (is_file($root . '/views/default/elements/' . $base)) {
                continue;
            }
            if (strpos($allPhp, 'css/elements/' . $stem) !== false) {
                continue;
            }
            $violations[] = "css/elements/{$base} has no relocated twin and is not loaded explicitly → never loads on Elgg 7";
        }
        $this->assertSame([], $violations, "Orphaned css/elements overrides:\n" . implode("\n", $violations));
    }
}
