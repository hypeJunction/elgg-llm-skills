{
  "_meta": {
    "description": "Global functions REMOVED at each Elgg major version, with their replacement. Used by PostMigrationVerifier::checkRemovedFunctions() to flag calls to functions that no longer exist at the migration target (the 'undefined symbol' class the shape-based completeness gate is blind to — bd elgg-migrate-abyju). Each target version's set is treated cumulatively: a function removed at 4.x is still removed at 6.x.",
    "method": "Verified empirically via Elgg\\Application::loadCore() + function_exists() inside the real core container (not static grep, which is fooled by plugin-provided functions). 6.x set verified against Elgg 6.1.5 on 2026-06-03.",
    "false_positives_excluded": {
      "elgg_ws_expose_function": "provided by the web_services bundled plugin — not a core removal",
      "elgg_stars_get_entity_rating_values": "provided by the elgg_stars plugin"
    }
  },
  "6.x": {
    "elgg_trigger_plugin_hook": "elgg_trigger_event_results",
    "elgg_register_plugin_hook_handler": "elgg_register_event_handler",
    "elgg_unregister_plugin_hook_handler": "elgg_unregister_event_handler",
    "elgg_clear_plugin_hook_handlers": "elgg_clear_event_handlers",
    "register_error": "elgg_register_error_message",
    "system_message": "elgg_register_success_message",
    "forward": "elgg_redirect_response",
    "elgg_redirect": "elgg_redirect_response",
    "current_page_url": "elgg_get_current_url",
    "_elgg_rmdir": "elgg_delete_directory",
    "elgg_load_css": "elgg_require_css",
    "elgg_load_js": "ESM: register .mjs + elgg_import_esm()",
    "elgg_require_js": "elgg_import_esm()",
    "elgg_define_js": "elgg_register_esm()",
    "elgg_unregister_css": "elgg_unregister_external_file('css', $name)",
    "elgg_flush_caches": "elgg_clear_caches",
    "elgg_get_version": "elgg_get_release",
    "elgg_instanceof": "$e instanceof \\ElggObject && $e->getSubtype() === $subtype",
    "elgg_set_ignore_access": "elgg_call(ELGG_IGNORE_ACCESS, function () { ... })",
    "elgg_view_input": "elgg_view_field(['#type' => $type] + $vars)",
    "elgg_format_attributes": "elgg_format_element('', $attrs)",
    "elgg_view_menu_item": "elgg_view('navigation/menu/elements/item', ['item' => ...])",
    "elgg_pop_breadcrumb": "breadcrumbs auto-managed; remove or use elgg_set_breadcrumbs([])",
    "elgg_set_plugin_setting": "elgg_get_plugin_from_id($id)->setSetting($name, $value)",
    "elgg_unset_plugin_setting": "elgg_get_plugin_from_id($id)->unsetSetting($name)",
    "elgg_set_plugin_user_setting": "elgg_get_plugin_from_id($id)->setUserSetting($name, $value, $user_guid)",
    "elgg_unset_plugin_user_setting": "elgg_get_plugin_from_id($id)->unsetUserSetting($name, $user_guid)",
    "elgg_delete_metadata_by_id": "elgg_delete_metadata(['metadata_id' => $id])",
    "elgg_add_subscription": "ElggEntity::addSubscription() / notifications subscription API",
    "elgg_group_gatekeeper": "elgg_group_gatekeeper() removed — use elgg_entity_gatekeeper() / group access checks",
    "elgg_get_group_tool_options": "$group->getTools()",
    "elgg_get_file_simple_type": "ElggFile::getSimpleType() / MimeTypeService",
    "elgg_get_registered_tag_metadata_names": "tag-metadata registration API removed",
    "elgg_list_views": "internal API removed",
    "elgg_register_admin_menu_item": "elgg_register_menu_item('page', ['parent_name' => 'administer', ...])",
    "elgg_strrchr": "mb_strrchr",
    "elgg_strripos": "mb_strripos",
    "elgg_set_view_location": "view location registration removed",
    "elgg_disable_annotations": "removed — annotations always enabled",
    "elgg_enable_annotations": "removed — annotations always enabled",
    "_elgg_html_decode": "html_entity_decode",
    "_elgg_get_display_query": "private API removed — use QueryBuilder",
    "_elgg_get_access_where_sql": "private API removed — use QueryBuilder access clauses",
    "_elgg_admin_add_plugin_settings_menu": "private API removed"
  }
}
