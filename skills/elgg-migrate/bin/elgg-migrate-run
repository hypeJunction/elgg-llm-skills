#!/usr/bin/env bash
# elgg-migrate-run — per-plugin isolated migration orchestrator.
#
# Spawns one Docker project per plugin, bind-mounts the plugin rw + its
# resolved dependencies ro, runs validation gates, and tears down cleanly.
# No host paths are baked in. Plugins source and job state are resolved
# from env → XDG config → cwd detection → prompt.
set -euo pipefail

# --- locate skill root (this script lives at <skill>/bin/elgg-migrate-run) ---
SCRIPT_PATH="$(readlink -f "$0")"
BIN_DIR="$(dirname "$SCRIPT_PATH")"
SKILL_ROOT="$(dirname "$BIN_DIR")"
SKILL_INFRA="$SKILL_ROOT/infra"

# --- XDG dirs ---
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/elgg-migrate"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/elgg-migrate"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/elgg-migrate"
CONFIG_FILE="$CONFIG_HOME/config.json"
JOBS_DIR="$STATE_HOME/jobs"

mkdir -p "$CONFIG_HOME" "$STATE_HOME" "$CACHE_HOME" "$JOBS_DIR"

# --- deps check ---
need() { command -v "$1" >/dev/null 2>&1 || { echo "missing dep: $1" >&2; exit 2; }; }
need docker
need jq
need git
need php

# Canonical Elgg core-plugin set — the union of what ships under
# vendor/elgg/elgg/mod/ across Elgg 4.x and 5.x. Override with
# ELGG_CORE_PLUGINS to extend (whitespace-separated list). Used by the
# resolver to classify deps that aren't in the workspace but are bundled
# with the elgg/elgg release; the install script symlinks them into
# /var/www/html/mod/ before activation.
ELGG_CORE_PLUGINS_DEFAULT="activity blog bookmarks ckeditor custom_index dashboard developers discussions externalpages file friends garbagecollector groups htmlawed invitefriends legacy_urls likes members messageboard messages notifications pages profile reportedcontent search site_notifications system_log tagcloud theme thewire uservalidationbyemail web_services"

is_core_plugin() {
  local id="$1" list="${ELGG_CORE_PLUGINS:-$ELGG_CORE_PLUGINS_DEFAULT}" p
  for p in $list; do
    [[ "$p" == "$id" ]] && return 0
  done
  return 1
}

# --- config I/O ---
config_get() {
  local key="$1"
  [[ -f "$CONFIG_FILE" ]] || { echo ""; return; }
  jq -r --arg k "$key" '.[$k] // ""' "$CONFIG_FILE"
}

config_set() {
  local key="$1" val="$2" tmp
  tmp="$(mktemp)"
  if [[ -f "$CONFIG_FILE" ]]; then
    jq --arg k "$key" --arg v "$val" '.[$k] = $v' "$CONFIG_FILE" > "$tmp"
  else
    jq -nc --arg k "$key" --arg v "$val" '{($k): $v}' > "$tmp"
  fi
  mv "$tmp" "$CONFIG_FILE"
}

# --- plugin source discovery ---
is_plugin_dir() {
  [[ -f "$1/elgg-plugin.php" || -f "$1/start.php" ]]
}

resolve_plugins_source() {
  if [[ -n "${ELGG_MIGRATE_PLUGINS:-}" ]]; then
    echo "$ELGG_MIGRATE_PLUGINS"; return
  fi
  local cached; cached="$(config_get plugins_source)"
  if [[ -n "$cached" && -d "$cached" ]]; then
    echo "$cached"; return
  fi
  local cwd; cwd="$(pwd)"
  if is_plugin_dir "$cwd"; then
    echo "$(dirname "$cwd")"; return
  fi
  local hit=0
  for d in "$cwd"/*/; do
    [[ -d "$d" ]] || continue
    if is_plugin_dir "$d"; then hit=1; break; fi
  done
  if (( hit )); then echo "$cwd"; return; fi
  echo "" # caller handles prompt
}

cmd_init() {
  local source="" from="" to=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plugins-source=*) source="${1#*=}" ;;
      --from=*) from="${1#*=}" ;;
      --to=*) to="${1#*=}" ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
  done
  if [[ -z "$source" ]]; then
    source="$(resolve_plugins_source)"
  fi
  if [[ -z "$source" ]]; then
    read -r -p "Plugins source directory (absolute path): " source
  fi
  source="$(readlink -f "$source")"
  [[ -d "$source" ]] || { echo "not a directory: $source" >&2; exit 1; }
  config_set plugins_source "$source"
  [[ -n "$from" ]] && config_set from_version "$from"
  [[ -n "$to"   ]] && config_set to_version "$to"
  config_set last_used_at "$(date -Iseconds)"
  echo "plugins_source = $source"
  echo "config         = $CONFIG_FILE"
  echo "state          = $STATE_HOME"
}

# --- job id: <plugin>-<short-sha> ---
job_sha() {
  local plugin_dir="$1" sha
  sha="$(git -C "$plugin_dir" rev-parse --short HEAD 2>/dev/null || true)"
  if [[ -z "$sha" ]]; then
    sha="$(printf '%s-%s' "$plugin_dir" "$(date +%s)" | sha1sum | cut -c1-8)"
  fi
  echo "$sha"
}

job_path() {
  local plugin="$1" sha="$2"
  echo "$JOBS_DIR/${plugin}-${sha}"
}

# --- dependency resolver ---
#
# Default: walks the plugin's declared deps recursively, resolving each
# to a sibling directory under $plugins_source. Source priority:
#   1. elgg-plugin.php — keys of the 'plugin.dependencies' array (Elgg 4.x+)
#   2. manifest.xml — <requires><type>plugin</type></requires> blocks (legacy)
# The lowercase dir name wins (Elgg 4.x plugin-id convention); falls
# back to the declared name for legacy camelCase sources. Composer
# library deps (elgg-plugin composer.json 'require' block) are NOT
# returned — they are composer-install targets, not bind mounts.
#
# Override: if the plugin declares tests/deps.txt, that file wins. Format:
#   <plugin-id> [git-url-with-#ref]    # optional inline comment
# Lines starting with '#' are comments, blank lines are skipped. The
# optional URL+ref suffix lets the deps file be self-bootstrapping for
# plugins not yet in the workspace, but for now the resolver only uses
# the first whitespace-separated token (the plugin id) and looks the
# directory up under $plugins_source. The resolver does NOT recurse
# into tests/deps.txt entries — the file is the exact set.
#
# Each dep is classified by source:
#   local   — present in $plugins_source; will be bind-mounted into the container
#   core    — bundled with elgg/elgg under vendor/elgg/elgg/mod/; install
#             script symlinks before activation. Listed in plugin-order.txt
#             so the install script activates it.
#   missing — declared but not present locally and not core. cmd_up bails.
#
# Emits deps.lock.json: [{"name": "...", "source": "local|core|missing", "path": "..."}]

# Parse a plugin's declared deps. Prefers elgg-plugin.php (Elgg 4.x+);
# falls back to manifest.xml for legacy plugins or transitional plugins
# whose elgg-plugin.php declares only bootstrap/routes/etc. but keeps
# the plugin-metadata block in manifest.xml. Emits one declared plugin
# id per line, in declaration order.
read_plugin_deps() {
  local plugin_dir="$1"
  local plugin_php="$plugin_dir/elgg-plugin.php"
  local manifest="$plugin_dir/manifest.xml"
  if [[ -f "$plugin_php" ]]; then
    # The elgg-plugin.php file is `<?php return [...];`. Including it in
    # a sandbox returns the manifest array. Using @include + array
    # access only — no class autoloading is triggered (::class
    # references resolve to FQCN strings without loading the class).
    # Exit code 0 = plugin key present (use elgg-plugin.php as
    # authoritative, even if dependencies is empty). Exit code 2 = no
    # plugin key at all → caller falls back to manifest.xml.
    if php -d display_errors=0 -d error_reporting=0 -r '
      $file = $argv[1];
      $a = @include $file;
      if (!is_array($a) || !array_key_exists("plugin", $a) || !is_array($a["plugin"])) {
          exit(2);
      }
      $deps = $a["plugin"]["dependencies"] ?? [];
      if (!is_array($deps)) { exit(0); }
      foreach (array_keys($deps) as $k) { echo $k, "\n"; }
    ' "$plugin_php" 2>/dev/null; then
      return 0
    fi
    # plugin key absent — fall through to manifest.xml.
  fi
  if [[ -f "$manifest" ]]; then
    python3 -c "
import re
t=open('$manifest').read()
for m in re.finditer(r'<requires>\s*<type>plugin</type>\s*<name>([^<]+)</name>', t):
    print(m.group(1))
"
  fi
}

# Classify a declared dep id into (source, path). Echoes "<source>\t<path>".
# - local: $plugins_source/<lower-or-declared> exists and is a plugin dir
# - core:  matches the known elgg/elgg core-plugin set
# - missing: anything else
classify_dep() {
  local name="$1" plugins_source="$2" lower="${1,,}"
  local candidate path
  for candidate in "$plugins_source/$lower" "$plugins_source/$name"; do
    if [[ -d "$candidate" ]] && is_plugin_dir "$candidate"; then
      path="$(readlink -f "$candidate")"
      printf 'local\t%s\n' "$path"
      return 0
    fi
  done
  if is_core_plugin "$lower"; then
    printf 'core\t\n'
    return 0
  fi
  printf 'missing\t\n'
}

resolve_deps() {
  local plugin_dir="$1" plugins_source="$2"
  local override="$plugin_dir/tests/deps.txt"
  if [[ -f "$override" ]]; then
    local out="[]" line stripped name lower classified source path
    while IFS= read -r line; do
      # Strip everything from a leading '#' (full-line comment) so
      # entries with trailing '# ...' notes also work.
      stripped="${line%%#*}"
      # First whitespace-separated token = plugin id; ignore the rest
      # (URL/ref suffix used by the bootstrap-from-clone path).
      read -r name _rest <<< "$stripped"
      [[ -z "$name" ]] && continue
      lower="${name,,}"
      classified="$(classify_dep "$name" "$plugins_source")"
      source="${classified%%$'\t'*}"
      path="${classified#*$'\t'}"
      out="$(jq --arg n "$lower" --arg s "$source" --arg p "$path" \
        '. + [{name: $n, source: $s, path: $p}]' <<< "$out")"
    done < "$override"
    echo "$out"
    return 0
  fi
  local visited=() out="[]"
  _resolve_deps_rec() {
    local names
    names="$(read_plugin_deps "$1")"
    while IFS= read -r name; do
      [[ -z "$name" ]] && continue
      local lower="${name,,}"
      # skip if already visited
      local seen=0 v
      for v in "${visited[@]:-}"; do
        [[ "$v" == "$lower" ]] && { seen=1; break; }
      done
      (( seen )) && continue
      visited+=("$lower")
      local classified source path
      classified="$(classify_dep "$name" "$plugins_source")"
      source="${classified%%$'\t'*}"
      path="${classified#*$'\t'}"
      # Post-order: recurse FIRST so deeper deps (leaves) land earlier in
      # the list, and this plugin's parents land after. The resulting order
      # is a valid activation order for Elgg's plugin-order.txt. Recurse
      # only into local deps — core deps live in vendor/ and aren't
      # walkable from the host, and missing deps have no path.
      [[ "$source" == "local" && -n "$path" ]] && _resolve_deps_rec "$path"
      out="$(jq --arg n "$lower" --arg s "$source" --arg p "$path" \
        '. + [{name: $n, source: $s, path: $p}]' <<< "$out")"
    done <<< "$names"
  }
  _resolve_deps_rec "$plugin_dir"
  echo "$out"
}

cmd_resolve() {
  local plugin="${1:?plugin id required}"
  local src; src="$(config_get plugins_source)"
  [[ -n "$src" ]] || { echo "run 'elgg-migrate-run init' first" >&2; exit 1; }
  local pdir="$src/$plugin"
  is_plugin_dir "$pdir" || { echo "not a plugin: $pdir" >&2; exit 1; }
  resolve_deps "$pdir" "$src"
}

# --- post-up hooks ---

# Poll for the .elgg-installed marker the install script writes when it
# finishes. The compose 'up -d' returns as soon as the container is
# *started*, but elgg-install.sh runs a multi-step composer install +
# plugin activation before Apache starts; without waiting, subsequent
# exec calls race against the install and see missing vendor/ entries.
wait_for_install() {
  local project="$1"
  local service="${2:-elgg}"
  local max_seconds="${3:-180}"
  local elapsed=0
  while (( elapsed < max_seconds )); do
    if docker compose --project-name "$project" exec -T "$service" \
        test -f /var/www/html/.elgg-installed 2>/dev/null; then
      return 0
    fi
    sleep 2
    elapsed=$(( elapsed + 2 ))
  done
  echo "timed out waiting for .elgg-installed after ${max_seconds}s" >&2
  return 1
}

# Parse a plugin's composer.json 'require' block and emit each non-core,
# non-virtual dep as a packagist name. Skips:
#   - php / ext-* / lib-* (virtual platform requires)
#   - elgg/elgg (already installed as the root project)
#   - composer/installers (already in the base image)
#   - self-references matching the plugin's own composer name
plugin_lib_requires() {
  local plugin_dir="$1"
  local composer="$plugin_dir/composer.json"
  [[ -f "$composer" ]] || return 0
  local self
  self="$(jq -r '.name // empty' "$composer")"
  jq -r --arg self "$self" '
    .require // {}
    | to_entries[]
    | select(.key | test("^(php$|ext-|lib-|elgg/elgg$|composer/installers$)") | not)
    | select(.key != $self)
    | .key
  ' "$composer"
}

# Run composer require inside the running elgg service for every plugin
# library dep declared by the plugin under test and its mounted siblings.
# Runs inside the container so the install uses the same composer version
# and vendor path as the rest of the environment, and the installed libs
# persist for the lifetime of the container (until 'down -v').
install_plugin_libs() {
  local project="$1" plugin_dir="$2" deps_json="$3"
  local -a libs=()
  # start with the plugin under test
  while IFS= read -r lib; do
    [[ -n "$lib" ]] && libs+=("$lib")
  done < <(plugin_lib_requires "$plugin_dir")
  # then each mounted local dep
  while IFS= read -r dep_path; do
    [[ -z "$dep_path" ]] && continue
    while IFS= read -r lib; do
      [[ -n "$lib" ]] && libs+=("$lib")
    done < <(plugin_lib_requires "$dep_path")
  done < <(jq -r '.[] | select(.source=="local") | .path' <<< "$deps_json")
  (( ${#libs[@]} )) || { echo "no plugin library deps to install"; return 0; }
  # dedup preserving order
  local -a uniq=()
  local seen lib
  for lib in "${libs[@]}"; do
    seen=0
    for u in "${uniq[@]:-}"; do [[ "$u" == "$lib" ]] && { seen=1; break; }; done
    (( seen )) || uniq+=("$lib")
  done
  echo "installing plugin library deps: ${uniq[*]}"
  docker compose --project-name "$project" exec -T -w /var/www/html elgg \
    composer require --no-interaction "${uniq[@]}"
}

# --- compose invocation ---
compose_args() {
  local plugin="$1" sha="$2" version="$3" jdir="$4"
  local base="$SKILL_INFRA/$version/docker-compose.yml"
  [[ -f "$base" ]] || { echo "no infra for version: $version ($base)" >&2; exit 1; }
  echo "--project-name em-${plugin}-${sha} --env-file $jdir/.env -f $base -f $jdir/override.yml"
}

write_override() {
  local plugin="$1" pdir="$2" deps_json="$3" jdir="$4"
  local file="$jdir/override.yml"
  local order="$jdir/plugin-order.txt"
  # deps are already in dependency order from the recursive walk (transitive
  # leaves first). Both local and core deps need to be activated by the
  # install script, so both go into the order file. Core deps aren't
  # bind-mounted (they ship with elgg/elgg) — the install script symlinks
  # them from vendor/elgg/elgg/mod/ before activation. Plugin under test
  # goes last.
  {
    jq -r '.[] | select(.source=="local" or .source=="core") | .name' <<< "$deps_json"
    echo "$plugin"
  } > "$order"
  # Mask subpaths: any subpath of a bind-mounted plugin where an in-
  # container install would otherwise write through to the host source
  # tree. Each mask gets backed by a per-job host directory under
  # $jdir/node_modules/<plugin>/<sub>, which the wrapper creates with the
  # caller's uid so the in-container install (running as the same user
  # via the 'user:' override) can write into it. The result: the source
  # tree stays untouched, package-lock.json + node_modules contents live
  # under $XDG_STATE_HOME/elgg-migrate/jobs/<plugin>-<sha>/node_modules/,
  # ownership is the user (deletable, gitignorable, no root).
  local mask_subpaths=(tests/vitest/node_modules tests/playwright/node_modules)
  mkdir -p "$jdir/node_modules"
  {
    echo "services:"
    echo "  elgg:"
    echo "    volumes:"
    echo "      - ${pdir}:/var/www/html/mod/${plugin}"
    # Deps mount read-write: Elgg's class autoloader writes scan caches into
    # the plugin dir at activation time (see
    # vendor/elgg/elgg/engine/classes/Elgg/ClassLoader.php).
    jq -r '.[] | select(.source=="local") | "      - " + .path + ":/var/www/html/mod/" + .name' <<< "$deps_json"
    # Activation order file — makes the install script activate transitive
    # deps before the plugin under test, instead of alphabetical.
    echo "      - ${order}:/var/www/html/mod/.plugin-order.txt"
    echo "  node:"
    # Run as the host user so any file the container writes through a
    # bind mount (package-lock.json, node_modules contents) is owned by
    # the user, not by root. The playwright base image runs as root by
    # default, which would leave files the user can't delete.
    echo "    user: \"$(id -u):$(id -g)\""
    echo "    volumes:"
    echo "      - ${pdir}:/plugins/${plugin}"
    # Mask container-side install dirs for the plugin under test by
    # bind-mounting a job-dir subdir over them — empty + user-owned, so
    # in-container 'npm install' writes there instead of the source tree.
    #
    # Pre-create the host-side mount-point inside the source tree as the
    # caller's uid before compose runs. Without this Docker creates the
    # empty stub root-owned (mount-point setup happens before the
    # 'user:' override applies), leaving an undeletable dir on disk.
    local mask_dir host_stub
    for sub in "${mask_subpaths[@]}"; do
      mask_dir="$jdir/node_modules/${plugin}/${sub}"
      mkdir -p "$mask_dir"
      host_stub="${pdir}/${sub}"
      mkdir -p "$host_stub"
      echo "      - ${mask_dir}:/plugins/${plugin}/${sub}"
    done
    # Same treatment for each mounted dep.
    while IFS= read -r dep_name; do
      [[ -z "$dep_name" ]] && continue
      local dep_path
      dep_path="$(jq -r --arg n "$dep_name" '.[] | select(.name==$n) | .path' <<< "$deps_json")"
      [[ -z "$dep_path" ]] && continue
      echo "      - ${dep_path}:/plugins/${dep_name}"
      for sub in "${mask_subpaths[@]}"; do
        mask_dir="$jdir/node_modules/${dep_name}/${sub}"
        mkdir -p "$mask_dir"
        host_stub="${dep_path}/${sub}"
        mkdir -p "$host_stub"
        echo "      - ${mask_dir}:/plugins/${dep_name}/${sub}"
      done
    done < <(jq -r '.[] | select(.source=="local") | .name' <<< "$deps_json")
  } > "$file"
}

cmd_up() {
  local plugin="${1:?plugin id required}"; shift
  local version="elgg4"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version=*) version="${1#*=}" ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
  done
  case "$version" in
    elgg2|elgg3|elgg4|elgg5|elgg6|elgg7) ;;
    *) echo "unknown --version: $version (expected elgg2|elgg3|elgg4|elgg5|elgg6|elgg7)" >&2; exit 2 ;;
  esac
  local src; src="$(config_get plugins_source)"
  [[ -n "$src" ]] || { echo "run 'elgg-migrate-run init' first" >&2; exit 1; }
  local pdir="$src/$plugin"
  is_plugin_dir "$pdir" || { echo "not a plugin: $pdir" >&2; exit 1; }
  local sha; sha="$(job_sha "$pdir")"
  local jdir; jdir="$(job_path "$plugin" "$sha")"
  mkdir -p "$jdir/logs"
  local deps; deps="$(resolve_deps "$pdir" "$src")"
  echo "$deps" > "$jdir/deps.lock.json"
  local missing; missing="$(jq -r '[.[] | select(.source=="missing")] | length' <<< "$deps")"
  if (( missing > 0 )); then
    jq -r '.[] | select(.source=="missing") | "  ! missing dep: " + .name' <<< "$deps" >&2
    echo "resolve deps before spawning, or run with --allow-missing-deps (not yet implemented)" >&2
    exit 1
  fi
  write_override "$plugin" "$(readlink -f "$pdir")" "$deps" "$jdir"
  local port; port=$(( (RANDOM % 1000) + 18000 ))
  local dbport; dbport=$(( (RANDOM % 1000) + 13000 ))
  # PLUGINS_DIR is the workspace root so the skill-infra compose file can
  # interpolate ${PLUGINS_DIR}/${PLUGIN_ID} consistently across services.
  # The elgg service's bind mount is already written into override.yml with
  # absolute paths, so the node service is the only consumer of these vars.
  cat > "$jdir/.env" <<EOF
ELGG_PORT=$port
DB_PORT=$dbport
PLUGINS_DIR=$(readlink -f "$src")
PLUGIN_ID=$plugin
EOF
  cat > "$jdir/report.json" <<EOF
{
  "plugin": "$plugin",
  "sha": "$sha",
  "version": "$version",
  "skill_root": "$SKILL_ROOT",
  "skill_commit": "$(git -C "$SKILL_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)",
  "created_at": "$(date -Iseconds)",
  "elgg_port": $port,
  "db_port": $dbport
}
EOF
  # shellcheck disable=SC2046
  ( cd "$jdir" && docker compose $(compose_args "$plugin" "$sha" "$version" "$jdir") up -d --build )
  local project="em-${plugin}-${sha}"
  wait_for_install "$project" || echo "  (install still running — rerun composer require manually if libs are missing)" >&2
  install_plugin_libs "$project" "$(readlink -f "$pdir")" "$deps" || \
    echo "  (plugin-lib install failed — rerun manually: docker compose --project-name $project exec elgg composer require ...)" >&2
  echo "job dir: $jdir"
  echo "elgg:    http://localhost:$port"
}

cmd_down() {
  local plugin="${1:?plugin id required}"
  local jdir jshort version sha
  jdir="$(find "$JOBS_DIR" -maxdepth 1 -type d -name "${plugin}-*" -printf '%f\n' | head -n1)"
  [[ -n "$jdir" ]] || { echo "no job for $plugin" >&2; exit 1; }
  jdir="$JOBS_DIR/$jdir"
  sha="$(jq -r '.sha'     "$jdir/report.json")"
  version="$(jq -r '.version' "$jdir/report.json")"
  # shellcheck disable=SC2046
  ( cd "$jdir" && docker compose $(compose_args "$plugin" "$sha" "$version" "$jdir") down -v )
  echo "torn down: $jdir"
}

# Parse elgg-install.sh's activation output to determine the activation result
# for one plugin. The install script emits "  + <id>" for each plugin that
# activated, and "  - <id>: <error>" for each one that threw at activate() time.
# Activation failures do NOT fail .elgg-installed, so wait_for_install returning
# OK is not sufficient — we must parse the log.
#
# Reads logs on stdin so the parser is unit-testable without Docker. Outcomes:
#   activated       — exit 0, prints nothing
#   failed          — exit 1, prints the captured error message on stdout
#   not_attempted   — exit 2, plugin id never appeared in activation output
parse_activation_log() {
  local plugin="$1"
  local logs; logs="$(cat)"
  if grep -qE "^[[:space:]]*\+ ${plugin}\$" <<< "$logs"; then
    return 0
  fi
  local err
  err="$(grep -E "^[[:space:]]*- ${plugin}:" <<< "$logs" \
         | head -1 \
         | sed -E "s/^[[:space:]]*- ${plugin}: //")"
  if [[ -n "$err" ]]; then
    echo "$err"
    return 1
  fi
  return 2
}

# Thin wrapper: pipe the compose logs into parse_activation_log. Kept separate
# so the docker compose dependency lives in one place and the parser stays pure.
# --no-log-prefix strips the "elgg-1   | " service prefix so the parser's
# start-of-line anchored regex matches the install-script output directly.
fleet_check_activation() {
  local project="$1" plugin="$2"
  docker compose --project-name "$project" logs --no-color --no-log-prefix elgg 2>&1 \
    | parse_activation_log "$plugin"
}

cmd_verify_fleet() {
  local version="elgg7"
  local require_branch="migrate/elgg-7.x"
  local output=""
  local only=""
  local phpunit_arg=""
  local skip_render_arg=""
  local skip_phpcs_arg=""
  local keep_up_on_fail=0
  local dry_run=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version=*)        version="${1#*=}" ;;
      --require-branch=*) require_branch="${1#*=}" ;;
      --output=*)         output="${1#*=}" ;;
      --only=*)           only="${1#*=}" ;;
      --phpunit)          phpunit_arg="--phpunit" ;;
      --no-render)        skip_render_arg="--no-render" ;;
      --no-phpcs)         skip_phpcs_arg="--no-phpcs" ;;
      --keep-up-on-fail)  keep_up_on_fail=1 ;;
      --dry-run)          dry_run=1 ;;
      *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
    shift
  done
  case "$version" in
    elgg2|elgg3|elgg4|elgg5|elgg6|elgg7) ;;
    *) echo "unknown --version: $version" >&2; exit 2 ;;
  esac

  local src; src="$(config_get plugins_source)"
  [[ -n "$src" ]] || { echo "run 'elgg-migrate-run init' first" >&2; exit 1; }
  src="$(readlink -f "$src")"

  : "${output:=$STATE_HOME/fleet-activation-${version}.ndjson}"
  mkdir -p "$(dirname "$output")"
  : > "$output"  # truncate

  local verify_script="$BIN_DIR/elgg-migrate-verify"
  [[ -x "$verify_script" ]] || { echo "missing: $verify_script" >&2; exit 2; }

  # Build the list of candidate plugin dirs (sibling dirs of $src that contain
  # elgg-plugin.php or start.php — same predicate cmd_up uses).
  local -a plugins=()
  local d name
  while IFS= read -r -d '' d; do
    name="$(basename "$d")"
    is_plugin_dir "$d" || continue
    [[ -d "$d/.git" ]] || continue   # need git history for branch checks
    if [[ -n "$only" ]]; then
      case ",${only}," in *",${name},"*) ;; *) continue ;; esac
    fi
    plugins+=("$name")
  done < <(find "$src" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)

  local total=${#plugins[@]}
  local pass=0 fail=0 skip=0 idx=0
  echo "fleet activation gate · version=$version · branch=$require_branch · plugins=$total"
  echo "output: $output"
  echo ""

  local plugin pdir current sha jdir project verify_rc act_status act_detail
  for plugin in "${plugins[@]}"; do
    idx=$(( idx + 1 ))
    pdir="$src/$plugin"
    printf "[%3d/%d] %-40s " "$idx" "$total" "$plugin"

    # --- branch guard ---------------------------------------------------------
    current="$(git -C "$pdir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
    if [[ "$current" != "$require_branch" ]]; then
      printf "SKIP (branch=%s)\n" "${current:-detached}"
      jq -nc --arg p "$plugin" --arg v "$version" --arg rb "$require_branch" --arg cb "$current" \
        '{plugin:$p, version:$v, status:"skip", reason:"branch_mismatch", required_branch:$rb, current_branch:$cb}' \
        >> "$output"
      skip=$(( skip + 1 )); continue
    fi

    if (( dry_run )); then
      printf "DRY-RUN (on %s)\n" "$require_branch"
      jq -nc --arg p "$plugin" --arg v "$version" --arg b "$require_branch" \
        '{plugin:$p, version:$v, status:"dry_run", branch:$b}' >> "$output"
      continue
    fi

    sha="$(job_sha "$pdir")"
    jdir="$(job_path "$plugin" "$sha")"
    mkdir -p "$jdir"
    project="em-${plugin}-${sha}"

    # --- up (build + install + activate) -------------------------------------
    if ! cmd_up "$plugin" --version="$version" >> "$jdir/verify-fleet.log" 2>&1; then
      printf "FAIL (up)\n"
      jq -nc --arg p "$plugin" --arg v "$version" --arg b "$require_branch" --arg s "$sha" \
            --arg log "$jdir/verify-fleet.log" \
        '{plugin:$p, version:$v, status:"up_failed", branch:$b, sha:$s, log:$log}' >> "$output"
      fail=$(( fail + 1 ))
      (( keep_up_on_fail )) || cmd_down "$plugin" >/dev/null 2>&1 || true
      continue
    fi

    # --- activation check (parse install log) --------------------------------
    if act_detail="$(fleet_check_activation "$project" "$plugin")"; then
      act_status="activated"
    else
      case $? in
        1) act_status="activation_failed" ;;
        2) act_status="not_attempted"; act_detail="plugin id never appeared in activation log" ;;
      esac
    fi

    if [[ "$act_status" != "activated" ]]; then
      printf "FAIL (%s)\n" "$act_status"
      jq -nc --arg p "$plugin" --arg v "$version" --arg b "$require_branch" --arg s "$sha" \
            --arg st "$act_status" --arg d "$act_detail" --arg pj "$project" \
        '{plugin:$p, version:$v, status:$st, branch:$b, sha:$s, project:$pj, error:$d}' >> "$output"
      fail=$(( fail + 1 ))
      (( keep_up_on_fail )) || cmd_down "$plugin" >/dev/null 2>&1 || true
      continue
    fi

    # --- full verify gates (--json gives a structured summary) ---------------
    local verify_json verify_tmp
    verify_tmp="$(mktemp)"
    set +e
    "$verify_script" "$pdir" --project="$project" --plugin-id="$plugin" --json \
      $phpunit_arg $skip_render_arg $skip_phpcs_arg \
      > "$verify_tmp" 2>>"$jdir/verify-fleet.log"
    verify_rc=$?
    set -e
    # Last line of stdout is the JSON summary; earlier lines are the TTY report
    # (in case the user is watching live).
    verify_json="$(tail -n1 "$verify_tmp" | jq -c . 2>/dev/null || echo '{}')"
    cat "$verify_tmp" | sed '$d'  # echo TTY report (drop json line)
    rm -f "$verify_tmp"

    if (( verify_rc == 0 )); then
      printf "PASS\n"
      jq -nc --arg p "$plugin" --arg v "$version" --arg b "$require_branch" --arg s "$sha" \
            --arg pj "$project" --argjson g "$verify_json" \
        '{plugin:$p, version:$v, status:"pass", branch:$b, sha:$s, project:$pj, verify:$g}' >> "$output"
      pass=$(( pass + 1 ))
      cmd_down "$plugin" >/dev/null 2>&1 || true
    else
      printf "FAIL (gates)\n"
      jq -nc --arg p "$plugin" --arg v "$version" --arg b "$require_branch" --arg s "$sha" \
            --arg pj "$project" --argjson g "$verify_json" \
        '{plugin:$p, version:$v, status:"verify_failed", branch:$b, sha:$s, project:$pj, verify:$g}' >> "$output"
      fail=$(( fail + 1 ))
      (( keep_up_on_fail )) || cmd_down "$plugin" >/dev/null 2>&1 || true
    fi
  done

  echo ""
  echo "=== summary ==="
  printf "  %d PASS  %d FAIL  %d SKIP  (of %d)\n" "$pass" "$fail" "$skip" "$total"
  echo "  results: $output"
  if (( total > 0 && skip == total )); then
    echo ""
    echo "  All plugins skipped — none currently on $require_branch."
    echo "  Check out the target branch on each plugin before running this gate, e.g.:"
    echo "    for d in $src/*/; do (cd \"\$d\" && git checkout $require_branch 2>/dev/null); done"
  fi
  (( fail == 0 ))
}

cmd_status() {
  if [[ $# -eq 0 ]]; then
    find "$JOBS_DIR" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' | sort
    return
  fi
  local plugin="$1" jdir
  jdir="$(find "$JOBS_DIR" -maxdepth 1 -type d -name "${plugin}-*" -printf '%p\n' | head -n1)"
  [[ -n "$jdir" ]] || { echo "no job for $plugin" >&2; exit 1; }
  jq . "$jdir/report.json"
  echo "--- deps.lock.json ---"
  jq . "$jdir/deps.lock.json"
}

usage() {
  cat <<'EOF'
elgg-migrate-run — isolated per-plugin migration orchestrator

  init    [--plugins-source=<dir>] [--from=N.x] [--to=N.x]
  resolve <plugin>
  up      <plugin> [--version=elgg2|elgg3|elgg4|elgg5|elgg6|elgg7]
  down    <plugin>
  status  [<plugin>]
  verify-fleet [--version=elgg7] [--require-branch=migrate/elgg-7.x]
               [--only=p1,p2,...] [--output=PATH]
               [--phpunit] [--no-render] [--no-phpcs]
               [--keep-up-on-fail] [--dry-run]

State lives under $XDG_STATE_HOME/elgg-migrate/. Config under
$XDG_CONFIG_HOME/elgg-migrate/config.json. No host paths are baked in.
EOF
}

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    init)         cmd_init         "$@" ;;
    resolve)      cmd_resolve      "$@" ;;
    up)           cmd_up           "$@" ;;
    down)         cmd_down         "$@" ;;
    status)       cmd_status       "$@" ;;
    verify-fleet) cmd_verify_fleet "$@" ;;
    ""|-h|--help|help) usage ;;
    *) echo "unknown subcommand: $sub" >&2; usage >&2; exit 2 ;;
  esac
}

# Only run main when executed directly, so unit tests can source the script
# and exercise the pure helpers (parse_activation_log, classify_dep, etc.).
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
