{
    "name": "acme/elgg-migrate",
    "description": "Automated migration toolkit for Elgg CMS plugins — migrate from legacy versions to modern Elgg one version at a time",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "ElggMigrate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElggMigrate\\Tests\\": "tests/"
        }
    }
}
